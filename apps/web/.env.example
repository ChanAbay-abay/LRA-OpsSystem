VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3099

# Dev-only quick-switch buttons on /login (lib/demo-logins.ts). Rendered
# ONLY when `import.meta.env.DEV` is true AND left unset in production.
# A JSON object mapping email -> password; every email must end in
# `@ops-demo.invalid` or it is silently dropped, not rendered. These are
# throwaway test accounts and are expected to be deleted eventually --
# never put a real credential in this file or in your local .env.
# Placeholders only, no real passwords:
# VITE_DEMO_LOGINS={"founder-demo@ops-demo.invalid":"changeme","gm-demo@ops-demo.invalid":"changeme","sales-demo@ops-demo.invalid":"changeme","broker-demo@ops-demo.invalid":"changeme"}
