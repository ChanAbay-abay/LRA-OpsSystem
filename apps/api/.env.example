# Supabase project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server only. Bypasses row level security. Never expose this in the
# frontend bundle or commit it.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3099
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# The web app's own base URL, used to build the redirectTo on invite/
# recovery emails so the link lands on /set-password. Optional in dev —
# falls back to CORS_ORIGIN's first entry (lib/env.ts webAppUrl()) — but
# set explicitly in production, since CORS_ORIGIN may list more than one
# origin there.
# WEB_APP_URL=http://localhost:5173

# The POSTGRES connection string — a different thing from SUPABASE_URL
# above, which is the REST API and cannot be used by psql. The API server
# does not read this; `npm run test:rls` does, so that the RLS suite can
# be run without exporting it by hand every time.
#
# Local:  supabase start, then use the string it prints
#         postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Live:   Supabase dashboard > Project Settings > Database >
#         Connection string > URI
#
# URL-ENCODE the password: '!' is %21, '@' is %40, '#' is %23. An
# un-encoded special character silently truncates the URL, and the
# failure reads as a wrong password rather than a malformed string.
# DATABASE_URL=
