# Supabase project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server only. Bypasses row level security. Never expose this in the
# frontend bundle or commit it.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3099
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# The web app's own base URL, used to build the redirectTo on invite/
# recovery emails so the link lands on /set-password. Optional in dev —
# falls back to CORS_ORIGIN's first entry (lib/env.ts webAppUrl()) — but
# set explicitly in production, since CORS_ORIGIN may list more than one
# origin there.
# WEB_APP_URL=http://localhost:5173
