{
  "name": "lra-ops-system",
  "version": "0.1.0",
  "private": true,
  "description": "LRA Global Ops Monitoring System.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @lra/ops-scoring && npm run build -w @lra/ops-api && npm run build -w @lra/ops-web",
    "test": "npm run test -w @lra/ops-scoring && npm run test -w @lra/ops-api",
    "dev:api": "npm run dev -w @lra/ops-api",
    "dev:web": "npm run dev -w @lra/ops-web",
    "db:push": "npx supabase@latest db push",
    "db:reset:local": "npx supabase@latest db reset",
    "test:rls": "bash scripts/run-rls-tests.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
